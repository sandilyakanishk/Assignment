// ============================================================================
// Jenkins Declarative Pipeline — Continuous Delivery with Blue-Green Deployment
// ============================================================================
//
// Flow:
//   Checkout → Build → Test → Build Image → Push → Deploy (Blue-Green)
//             → Smoke Test → Manual Approval → Switch Traffic → Verify
//
// On failure, the post block rolls back automatically. The previously-live
// color is still healthy and listening; flipping back to it is a fast,
// well-understood operation.
// ============================================================================

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE_NAME      = 'bluegreen-app'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        REGISTRY        = "registry.example.com"      // change to your registry
        FULL_IMAGE      = "${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
        DEPLOY_DIR      = "ci-cd-pipeline/deployment"
        SLACK_CHANNEL   = '#deployments'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ---------------- Continuous Integration ----------------

        stage('Build (Maven)') {
            steps {
                dir('ci-cd-pipeline/app') {
                    sh 'mvn -B clean package -DskipTests'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('ci-cd-pipeline/app') {
                    sh 'mvn -B test'
                }
            }
            post {
                always {
                    junit 'ci-cd-pipeline/app/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                dir('ci-cd-pipeline/app') {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                    sh "docker tag  ${IMAGE_NAME}:${IMAGE_TAG} ${FULL_IMAGE}"
                }
                withCredentials([usernamePassword(credentialsId: 'docker-registry',
                                                  usernameVariable: 'REG_USER',
                                                  passwordVariable: 'REG_PASS')]) {
                    sh '''
                        echo "$REG_PASS" | docker login $REGISTRY -u "$REG_USER" --password-stdin
                        docker push $FULL_IMAGE
                    '''
                }
            }
        }

        // ---------------- Continuous Delivery ----------------

        stage('Deploy to Inactive Color') {
            steps {
                dir(env.DEPLOY_DIR) {
                    sh "IMAGE_NAME=${IMAGE_NAME} ./scripts/deploy.sh ${IMAGE_TAG}"
                }
            }
        }

        // The deploy script ALREADY ran smoke tests on the inactive port before
        // switching. This stage runs additional / longer-running verifications
        // against the LIVE host:port that customers see.
        stage('Post-Switch Verification') {
            steps {
                sh '''
                    set -e
                    echo "Verifying live traffic on port 80 ..."
                    response=$(curl -fs http://localhost/)
                    echo "$response"
                    echo "$response" | grep -q "\\"version\\":\\"${IMAGE_TAG}\\"" \\
                        || { echo "ERROR: live version is not ${IMAGE_TAG}"; exit 1; }
                '''
            }
        }

        // Optional: pause for a human to confirm before the rollback window
        // closes (e.g., before tearing down the OLD color for the next deploy).
        // For fully automated CD, remove this stage.
        stage('Confirm Keep New Version') {
            when {
                expression { return env.BRANCH_NAME == 'main' }
            }
            steps {
                input(
                    message: "Live traffic is on the new version (${IMAGE_TAG}). " +
                             "Keep it, or roll back?",
                    ok: 'Keep new version',
                    parameters: [
                        choice(name: 'DECISION',
                               choices: ['KEEP', 'ROLLBACK'],
                               description: 'KEEP to confirm, ROLLBACK to revert')
                    ]
                )
                script {
                    if (env.DECISION == 'ROLLBACK') {
                        dir(env.DEPLOY_DIR) {
                            sh './scripts/rollback.sh'
                        }
                        error("Operator chose to roll back. Build marked failed.")
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Deployment ${IMAGE_TAG} succeeded."
            // slackSend channel: env.SLACK_CHANNEL, color: 'good',
            //     message: "✅ ${env.JOB_NAME} #${env.BUILD_NUMBER} deployed ${IMAGE_TAG}"
        }
        failure {
            echo "Deployment failed — initiating automatic rollback."
            dir(env.DEPLOY_DIR) {
                sh './scripts/rollback.sh || echo "Rollback failed — manual action required."'
            }
            // slackSend channel: env.SLACK_CHANNEL, color: 'danger',
            //     message: "❌ ${env.JOB_NAME} #${env.BUILD_NUMBER} failed; auto-rolled back"
        }
        always {
            sh 'docker logout $REGISTRY || true'
        }
    }
}
